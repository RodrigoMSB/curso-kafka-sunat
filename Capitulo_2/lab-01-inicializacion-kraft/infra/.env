# ============================================================
# NovaTech Logistics - Lab 01: Inicialización KRaft (SUNAT)
# Variables de entorno para Docker Compose
# ============================================================

# Versiones de imágenes
KAFKA_VERSION=8.2.0

# ID del clúster KRaft (base64, generado una vez)
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Puertos externos de los brokers, los que se publican al HOST.
# El valor por defecto es el de siempre y es el que ve el alumno.
# La forma ${VAR:-valor} deja que un valor exportado de afuera gane,
# que es lo que usan los e2e del instructor para no chocar con otro
# clúster que ya esté corriendo en la misma máquina.
BROKER_EXTERNAL_PORT=${BROKER_EXTERNAL_PORT:-9092}
