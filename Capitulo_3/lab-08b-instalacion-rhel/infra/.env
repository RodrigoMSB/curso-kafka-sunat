# ============================================================
# NovaTech Logistics - Lab 08b: variables del laboratorio
# ============================================================

# Proyecto compose. Es la frontera de lo que este lab puede destruir:
# ningun script del lab toca nada que no lleve esta etiqueta.
COMPOSE_PROJECT_NAME=novatech-lab08b

# Version de Confluent. Es la misma de los otros 13 labs, y esa igualdad
# es deliberada: si aqui se instalara otra, las salidas de este lab no
# calzarian con las del lab 01 y el alumno no podria compararlas.
KAFKA_VERSION=8.2.0

# Rama del repositorio yum de Confluent.
CONFLUENT_REPO=8.2

# Version de la imagen base de Red Hat.
UBI_TAG=9.8
